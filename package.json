{
  "name": "my-badge-studio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "test": "node --test --test-isolation=none tests/*.test.js",
    "test:e2e": "node tests/browser.mjs",
    "format": "prettier --write \"*.{js,html,css,json}\" \"tests/*.{js,mjs}\" \"docs/*.md\" README.md \"scripts/*.mjs\"",
    "format:check": "prettier --check \"*.{js,html,css,json}\" \"tests/*.{js,mjs}\" \"docs/*.md\" README.md \"scripts/*.mjs\"",
    "build:portable": "node scripts/build-portable.mjs",
    "test:portable": "node tests/portable.mjs",
    "test:canvas": "node tests/canvas.mjs",
    "test:editor": "node tests/editor-browser.mjs",
    "test:studio": "node tests/studio.mjs",
    "test:interactions": "node tests/interactions.mjs",
    "test:layout": "node tests/live-layout.mjs"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "playwright-core": "^1.64.1"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": ">=24"
  }
}
